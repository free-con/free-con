# Jarvis ayarları. Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# (Kurulum betiği bunu sizin için yapar.)

# ZORUNLU: Claude API anahtarınız -> https://console.anthropic.com (Settings > API Keys)
ANTHROPIC_API_KEY=

# Jarvis'in beyni olan Claude modeli:
#   claude-opus-5-5   en akıllı (varsayılan)
#   claude-sonnet-5-5 hızlı ve dengeli, daha ucuz
#   claude-haiku-5-5  en hızlı ve en ucuz
JARVIS_MODEL=claude-opus-5-5

# Düşünme derinliği: low (hızlı, sesli asistan için ideal), medium, high
JARVIS_EFFORT=low

# Size nasıl hitap etsin? (boş bırakırsanız "efendim" der)
JARVIS_USER_NAME=

# Asistanın adı ve uyanma kelimeleri (virgülle; konuşma tanıma "Jarvis"i farklı yazabilir)
JARVIS_NAME=Jarvis
JARVIS_WAKE_WORDS=jarvis,carvis,cervis,ceyvis,çarvis,jarviz,jervis

# Hava durumu ve aramalar için varsayılan konum
JARVIS_CITY=İstanbul
JARVIS_COUNTRY=TR
JARVIS_TIMEZONE=Europe/Istanbul

# Ses: tr-TR-AhmetNeural (erkek) veya tr-TR-EmelNeural (kadın); konuşma hızı
JARVIS_VOICE=tr-TR-AhmetNeural
JARVIS_VOICE_RATE=+8%

# Konuşma tanıma: google (ücretsiz, internet gerekir) veya whisper (internetsiz, önce: pip install faster-whisper)
JARVIS_STT=google
JARVIS_WHISPER_MODEL=small

# Mikrofon seçimi (boş = varsayılan). Liste için: python jarvis.py --mikrofonlar
JARVIS_MIC=

# Cevaptan sonra kaç saniye boyunca "Jarvis" demeden devam edebilirsiniz
JARVIS_FOLLOW_UP_SECONDS=8

# Hafıza, notlar ve hatırlatıcıların saklandığı klasör (boş = kullanıcı klasörünüzde "Jarvis")
JARVIS_DATA_DIR=

# İsteğe bağlı: Home Assistant ile akıllı ev kontrolü
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=uzun-ömürlü-erişim-anahtarı
HA_URL=
HA_TOKEN=
